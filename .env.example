# Optionnel : IA locale ou distante, compatible avec l'API OpenAI.
LLM_BASE_URL=http://ADRESSE_PRIVEE_IA:PORT/v1
LLM_API_KEY=remplacer-par-une-cle-secrete
LLM_MODEL=nom-du-modele
# Optionnel : paramètres spécifiques à certains serveurs, au format JSON.
# Exemple llama.cpp/Qwen : {"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY_JSON=

# Mot de passe de l'onglet Administration (à définir uniquement dans .env).
ADMIN_PASSWORD=choisir-un-mot-de-passe-fort
# Notifications e-mail : mettre 0 pour désactiver entièrement la fonctionnalité.
MAIL_NOTIFICATIONS_ENABLED=0
# SMTP_TO est facultatif : il sert uniquement de destinataire utilisateur par défaut.
# Les destinataires utilisateur et administrateur peuvent être définis dans l'interface.
# Les réglages administrateur ne sont visibles qu'après connexion à l'onglet Administration.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM="Veille Data & IA <noreply@example.org>"
SMTP_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# Archivage facultatif des alertes envoyées dans le dossier IMAP choisi.
MAIL_ARCHIVE_IMAP_ENABLED=0
MAIL_ARCHIVE_IMAP_HOST=localhost
MAIL_ARCHIVE_IMAP_PORT=143
MAIL_ARCHIVE_IMAP_ENCRYPTION=notls
# Validation du certificat pour ssl/starttls : 1 recommandé, 0 seulement pour un serveur local contrôlé.
MAIL_ARCHIVE_IMAP_VALIDATE_CERT=0
MAIL_ARCHIVE_IMAP_USERNAME=
MAIL_ARCHIVE_IMAP_PASSWORD=
MAIL_ARCHIVE_IMAP_MAILBOX=Sent
