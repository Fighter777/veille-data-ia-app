# Optionnel : enrichissement local par Qwen via le VPN.
QWEN_BASE_URL=http://10.8.0.45:17881/v1
QWEN_API_KEY=remplacer-par-une-cle-secrete
QWEN_MODEL=qwen3.8-27b-ud-q4_k_xl
# Notifications e-mail : mettre 0 pour désactiver entièrement la fonctionnalité.
MAIL_NOTIFICATIONS_ENABLED=0
# SMTP_TO est facultatif : les destinataires peuvent être renseignés depuis l'interface.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_FROM="Veille Data & IA <noreply@example.org>"
SMTP_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# Archivage facultatif des alertes envoyées dans le dossier IMAP choisi.
MAIL_ARCHIVE_IMAP_ENABLED=0
MAIL_ARCHIVE_IMAP_HOST=localhost
MAIL_ARCHIVE_IMAP_PORT=143
MAIL_ARCHIVE_IMAP_ENCRYPTION=notls
# Validation du certificat pour ssl/starttls : 1 recommandé, 0 seulement pour un serveur local contrôlé.
MAIL_ARCHIVE_IMAP_VALIDATE_CERT=0
MAIL_ARCHIVE_IMAP_USERNAME=
MAIL_ARCHIVE_IMAP_PASSWORD=
MAIL_ARCHIVE_IMAP_MAILBOX=Sent
